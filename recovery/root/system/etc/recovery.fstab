# 1 "vendor/mediatek/proprietary/hardware/fstab/mt6771/fstab.in"
# 1 "<built-in>"
# 1 "<command-line>"
# 1 "/usr/include/stdc-predef.h" 1 3 4
# 1 "<command-line>" 2
# 1 "vendor/mediatek/proprietary/hardware/fstab/mt6771/fstab.in"
# 100 "vendor/mediatek/proprietary/hardware/fstab/mt6771/fstab.in"
/dev/block/by-name/system /system ext4  ro  wait,,avb=boot,,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey

/dev/block/by-name/vendor /vendor ext4  ro  wait,,avb,,first_stage_mount

/dev/block/by-name/userdata /data ext4 noatime,nosuid,nodev,noauto_da_alloc,async_discard,defrag=on,errors=panic,inlinecrypt wait,check,formattable,quota,latemount,resize,reservedsize=128m,,fileencryption=aes-256-xts:aes-256-cts:v1


/dev/block/by-name/cache /cache ext4 noatime,nosuid,nodev,noauto_da_alloc,async_discard,defrag=on wait,check,formattable  #from fstab.mt6771

#/dev/block/by-name/persist /persist ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable


/dev/block/by-name/frp /persistent emmc defaults defaults

/dev/block/by-name/nvram /nvram emmc defaults defaults
/dev/block/by-name/proinfo /proinfo emmc defaults defaults
/dev/block/by-name/lk /bootloader emmc defaults defaults
/dev/block/by-name/lk2 /bootloader2 emmc defaults defaults
/dev/block/by-name/para /misc emmc defaults defaults
/dev/block/by-name/boot /boot emmc defaults defaults
/dev/block/by-name/recovery /recovery emmc defaults defaults
/dev/block/by-name/logo /logo emmc defaults defaults
